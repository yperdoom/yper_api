# Local (yarn db:up sobe um mongo:7 via docker compose em localhost:27017).
# Em producao, use a connection string do Atlas (sem o nome do banco no final).
MONGODB_URI=mongodb://localhost:27017

# Banco usado dentro do cluster
MONGODB_DB=yper

# Segredo de assinatura dos JWT. Gere com: openssl rand -base64 48
JWT_SECRET=troque-isto

# Origens liberadas no CORS, separadas por virgula.
# Vazio = libera qualquer origem (use so em desenvolvimento).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

PORT=4000

# Push: server-only service account JSON, or GOOGLE_APPLICATION_CREDENTIALS file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
YPER_PUBLIC_URL=https://yper.example.com
# Requires an always-running server; alternatively call the protected cron endpoint.
NOTIFICATIONS_SCHEDULER_ENABLED=false
NOTIFICATIONS_CRON_SECRET=
